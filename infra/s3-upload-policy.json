{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::demo-video-library-simongerula"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::demo-video-library-simongerula/library/*",
        "arn:aws:s3:::demo-video-library-simongerula/viewer/*"
      ]
    }
  ]
}
